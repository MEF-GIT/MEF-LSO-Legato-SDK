@startuml faultManagementJobStates

top to bottom direction

hide empty description

skinparam shadowing false
skinparam state {
	BackgroundColor #F9F9F9
	BorderColor #777
	FontSize 12
}
skinparam ArrowColor #555
skinparam ArrowThickness 1
skinparam defaultTextAlignment center

' Decision states with notes
state validation_successful <<choice>>
note right of validation_successful : Validation successful?
state immediate <<choice>>
note right of immediate : Immediate start time?
state resources <<choice>>
note right of resources : Resources available?
state recurring <<choice>>
note right of recurring : Recurring job?

' Concrete states
state acknowledged
state rejected
state in_progress as "inProgress"
state resource_unavailable as "resourcesUnavailable"
state pending_cancel as "pendingCancel"
state scheduled
state suspended
state pending
state completed
state cancelled
state end1 <<end>>

' === Validation ===
[*] --> acknowledged
acknowledged --> validation_successful
validation_successful --> immediate : Yes
validation_successful --> rejected : No
rejected --> end1

' === Scheduling ===
immediate -d-> resources : Yes
immediate -d-> scheduled : No
scheduled -r-> resources : schedule start time
scheduled --> pending_cancel : Cancel
scheduled --> pending : Modify
pending --> immediate

' === Execution ===
resources --> in_progress : Yes
resources --> resource_unavailable : No
in_progress --> recurring
in_progress --> pending_cancel : Cancel
in_progress --> suspended : Suspend
suspended --> in_progress : Resume
suspended --> pending_cancel : Cancel
suspended --> pending : Modify
recurring --> completed : No
recurring --> immediate : Yes

' === Termination ===
pending_cancel --> cancelled
completed --> [*]
cancelled --> [*]
resource_unavailable --> [*]

@enduml