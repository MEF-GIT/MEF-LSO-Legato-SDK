@startuml

class ServiceValue {
    id: String
    href: String
    place: RelatedPlaceRefOrValue
    serviceOffering: ServiceOfferingRef
    serviceRelationship: ServiceRelationship
    << ...attributes are skipped ...>>
}

class MefServiceConfiguration {
    @type: String <<discriminator>>
}

class IpEnni {
    identifier: String[1]
    enniType: EnniType [1]
    routingInformation: EnniRoutingInformation [1]
    ingressBandwidthProfileEnvelopes: IpEnniIngressBwpEnvelopePerEnniLink [1]
    egressBandwidthProfileEnvelopes: IpEnniEgressBwpEnvelopePerEnniLink [1]
}

enum EnniType {
    OPTION_A
    OPTION_B
    OPTION_C
}

class IpEnniCommon {
    peeringIdentifier: String[1]
    peeringType: EnniPeeringType [1]
    controlProtocolList: ControlProtocols [0..*]
    routingProtocols: RoutingProtocols [1]
    serviceMap: EnniServiceMap [1]
}

enum EnniPeeringType {
    OPTION_A
    OPTION_B
    OPTION_C
    OPTION_B_AND_C
}

IpEnniCommon "1" *--> "0..*" ControlProtocols
IpEnniCommon "1" *--> "1" RoutingProtocols
IpEnniCommon "1" *--> "1" EnniServiceMap

class ControlProtocols {
    "attributes not shown"
}

class RoutingProtocols {
    "attributes not shown"
}

class EnniServiceMap  {
    "attributes not shown"
}

IpEnni "1" *--> "1" EnniRoutingInformation
IpEnni "1" *--> "1" IpEnniIngressBwpEnvelopePerEnniLink
IpEnni "1" *--> "1" IpEnniEgressBwpEnvelopePerEnniLink

class EnniRoutingInformation {
    "attributes not shown"
}

class IpEnniIngressBwpEnvelopePerEnniLink {
    "attributes not shown"
}

class IpEnniEgressBwpEnvelopePerEnniLink  {
    "attributes not shown"
}

IpEnniCommon <|-- IpEnni
MefServiceConfiguration <|-- IpEnni
ServiceValue "1" *--> "0..1" MefServiceConfiguration: serviceConfiguration

@enduml