}

!define datatype(x) class x << (D,#FF7700) DataType>>

datatype(SecurityFunctionPolicy) {
    securityPolicyIdentifier: SecurityPolicyIdentifier[1]
    securityFunctionPolicyIdentifier: SecurityFunctionPolicyIdentifier[1]
    middleBoxSecurityFunctionPolicy: MiddleboxSecurityFunctionPolicy[0..1]
    ipPortProtocolFilteringSecurityFunctionPolicy: IpPortProtocolFilteringSecurityFunctionPolicy[0..1]
