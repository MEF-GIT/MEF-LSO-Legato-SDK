    dnsProtocolFilteringSecurityFunctionPolicy: DnsProtocolFilteringSecurityFunctionPolicy[0..1]
    protectiveDnsSecurityFunctionPolicy: ProtectiveDnsSecurityFunctionPolicy[0..1]
}

SecurityFunctionPolicy *--> "0..1" MiddleboxSecurityFunctionPolicy: middleBoxSecurityFunctionPolicy
SecurityFunctionPolicy *--> "0..1" IpPortProtocolFilteringSecurityFunctionPolicy: ipPortProtocolFilteringSecurityFunctionPolicy
SecurityFunctionPolicy *--> "0..1" DomainNameFilteringSecurityFunctionPolicy: domainNameFilteringSecurityFunctionPolicy
SecurityFunctionPolicy *--> "0..1" UrlFilteringSecurityFunctionPolicy: urlFilteringSecurityFunctionPolicy
SecurityFunctionPolicy *--> "0..1" MalwareDetectionRemovalSecurityFunctionPolicy: malwareDetectionRemovalSecurityFunctionPolicy
SecurityFunctionPolicy *--> "0..1" DataLossPreventionSecurityFunctionPolicy: dataLossPreventionSecurityFunctionPolicy
SecurityFunctionPolicy *--> "0..1" DnsProtocolFilteringSecurityFunctionPolicy: dnsProtocolFilteringSecurityFunctionPolicy
SecurityFunctionPolicy *--> "0..1" ProtectiveDnsSecurityFunctionPolicy: protectiveDnsSecurityFunctionPolicy

